{
  "name": "flowmind-desktop",
  "version": "0.1.0",
  "description": "FlowMind Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "concurrently \"npm run build:main\" \"wait-on dist/main.js && npm run start\"",
    "build": "npm run build:main",
    "build:app": "electron-builder"
  },
  "build": {
    "appId": "com.flowmind.desktop",
    "productName": "FlowMind",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "preload.js"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^10.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
